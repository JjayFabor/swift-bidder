APP_NAME="Swift Bidder"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
# Must match the host you actually browse the app on. Storage URLs for the local
# `public` disk are built from this value, so `http://localhost` while serving on
# :8000 will produce image links that 404.
APP_URL=http://127.0.0.1:8000

# Publishes the seeded demo credentials on the login screen and enables
# `php artisan demo:reset`. Leave false for any deployment holding real data.
APP_DEMO=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses MySQL; production on Render uses Postgres (DB_CONNECTION=pgsql
# with DB_URL supplied by the platform). Both are supported by the app.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=swift_bidder_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# The app resolves the broadcast driver during boot, so if this is `pusher` the
# PUSHER_* values below must be present or every request fails. Use `log` or `null`
# when you are not exercising real-time features.
BROADCAST_CONNECTION=log

# `public` writes to storage/app/public (served via the storage symlink).
# Production uses `s3`, pointed at Cloudflare R2 — see the AWS_* block.
FILESYSTEM_DISK=public

# SendTokenMail implements ShouldQueue. With `database` you must run
# `php artisan queue:work`, or OTP emails will never be delivered.
# Production uses `sync` because the free hosting tier has no worker process.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage for auction images and video. Works with any S3-compatible
# provider; Cloudflare R2 values look like:
#   AWS_DEFAULT_REGION=auto
#   AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   AWS_URL=https://<public-bucket-domain>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher Channels. The APP_KEY is a public client-side identifier and is compiled
# into the JS bundle; the APP_SECRET is server-side only and must never be exposed.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap1

# VITE_* values are inlined into the frontend bundle at build time. Changing one
# requires rebuilding assets, not just restarting the server.
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https
